{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InventoryApi": {
    "BaseUrl": "https://REPLACE-WITH-INVENTORY-API-HOST/",
    "ApiKeyHeaderName": "X-Api-Key",
    "PageSize": 25,
    "MaxConcurrentRequests": 4,
    "MaxPages": 1000,
    "MaxPageAttempts": 3,
    "CacheDuration": "00:05:00",
    "Resilience": {
      "MaxRetryAttempts": 3,
      "RetryDelay": "00:00:00.500",
      "UseJitter": true,
      "AttemptTimeout": "00:00:10",
      "TotalTimeout": "00:01:00",
      "BreakerFailureRatio": 0.5,
      "BreakerMinimumThroughput": 10,
      "BreakerSamplingDuration": "00:00:30",
      "BreakerBreakDuration": "00:00:15"
    }
  }
}
