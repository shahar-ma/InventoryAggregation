<Project>
  <!--
    Central Package Management: every NuGet version lives here so related packages are always upgraded together
    (important for the xunit.v3 / Microsoft.Testing.Platform stack, where a partial upgrade breaks test discovery).
    Re-check for newer releases with:  dotnet package list (with the outdated option)
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Production -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>